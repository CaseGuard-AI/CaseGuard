# Normalise line endings: LF in the repo and in working trees (team is on Windows + Linux CI).
* text=auto eol=lf

*.sh   text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf

# Binary
*.pdf  binary
*.docx binary
*.pptx binary
*.xlsx binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary

# Generated / vendored: collapse in PR diffs, exclude from language stats
pnpm-lock.yaml   linguist-generated=true -diff
uv.lock          linguist-generated=true -diff
packages/contracts/generated/** linguist-generated=true
docs/deliverables/** linguist-documentation=true
