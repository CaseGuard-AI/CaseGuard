{
  "name": "caseguard",
  "private": true,
  "description": "CaseGuard AI monorepo: see README.md and docs/engineering/local-setup.md",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:bootstrap": "node scripts/db-bootstrap.mjs",
    "db:migrate": "pnpm --filter ./apps/api run db:migrate",
    "db:migrate:ai": "uv run --directory services/ai alembic upgrade head",
    "db:migrate:ai:down": "uv run --directory services/ai alembic downgrade -1",
    "data:load": "uv run --directory services/ai python -m caseguard_ai.ingest.load",
    "data:embed": "uv run --directory services/ai python -m caseguard_ai.ingest.embed",
    "data:dump": "uv run --directory services/ai python -m caseguard_ai.ingest.dump",
    "data:pull": "uv run --directory services/ai python -m caseguard_ai.ingest.pull",
    "db:rebootstrap": "docker compose exec -T db bash /docker-entrypoint-initdb.d/01-schemas-and-roles.sh",
    "db:create-admin": "pnpm --filter ./apps/api run db:create-admin",
    "mail:check": "pnpm --filter ./apps/api run mail:check",
    "stack:up": "docker compose up --build -d --wait",
    "stack:down": "docker compose down",
    "dev": "concurrently -k -n web,api,ai -c blue,green,magenta \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:ai\"",
    "dev:web": "pnpm --filter ./apps/web run dev",
    "dev:api": "pnpm --filter ./apps/api run dev",
    "dev:ai": "uv run --directory services/ai uvicorn caseguard_ai.main:app --reload --port 8000",
    "gen:contracts": "pnpm --filter @caseguard/contracts run generate",
    "llm:check": "uv run --directory services/ai python -m caseguard_ai.gateway.check",
    "research:ask": "uv run --directory services/ai python -m caseguard_ai.research.ask_cli",
    "ai:support-eval": "uv run --directory services/ai python -m caseguard_ai.trust.support_eval",
    "ai:graph-build": "uv run --directory services/ai python -m caseguard_ai.graph.build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:py": "uv run --directory services/ai pytest -q && uv run --directory services/collector pytest -q",
    "format": "pnpm -r --if-present run format"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.0",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "qs@>=6.7.0 <=6.16.0": "^6.16.1",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
    },
    "ignoredBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  }
}
