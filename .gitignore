# ── Secrets ───────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Node / Next.js ────────────────────
node_modules/
.pnpm-store/
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*

# ── Python ────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# ── Data (never commit collected corpus or uploads) ──
services/collector/data/
services/collector/data_*/
!services/collector/data_demo/
/uploads/
/storage/
*.sqlite
# (anchored with a leading / on purpose: services/collector has Python packages named models/ and storage/)

# ── Model weights / eval artefacts ────
/models/
*.gguf
*.safetensors
/eval-runs/

# ── Tooling output ──
.playwright-mcp/

# ── OS / editors ──────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ── Office lock files ─────────────────
~$*
