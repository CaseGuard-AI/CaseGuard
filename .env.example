# Copy to .env and fill in. Never commit .env.
# Every new variable must be added here with a safe placeholder (CONTRIBUTING.md rule 6).

# ── Database (docker-compose.yml, infra/db, scripts/db-bootstrap.mjs) ────────
# Docker: POSTGRES_USER/PASSWORD create the superuser of the container.
# Native: set them to an existing superuser (usually postgres + your install password);
#         `pnpm db:bootstrap` creates POSTGRES_DB, the roles and the schemas.
# Port: if a native Postgres already listens on 5432 and you also run Docker, set
#       POSTGRES_PORT=5433 and change :5432 to :5433 in the three URLs below.
POSTGRES_USER=caseguard
POSTGRES_PASSWORD=change-me-superuser
POSTGRES_DB=caseguard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# PG_BIN=C:\Program Files\PostgreSQL\17\bin   # only if psql is not on PATH (auto-detected on Windows)
APP_DB_PASSWORD=change-me-app          # role caseguard_app (apps/api, schema app)
AI_DB_PASSWORD=change-me-ai            # role caseguard_ai  (services/ai + collector, schemas corpus, ai)

# ── apps/api ─────────────────────────────────────────────────────────────────
API_PORT=4000
API_DATABASE_URL=postgresql://caseguard_app:change-me-app@localhost:5432/caseguard
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
# AES-256-GCM key for users' own model-provider keys (FR-SET-2, SEC-4, ADR-0009): base64 of
# exactly 32 random bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Left empty, saving a key answers 503 (questions use the deployment's own models). Any other
# value that isn't 32 bytes of base64 stops the api at start-up. Changing it later makes the
# stored keys unreadable; users would re-enter them.
KEY_ENCRYPTION_KEY=
AI_SERVICE_URL=http://localhost:8000
# Uploads (#101, data-storage §6). Only `fs` for now. UPLOADS_DIR empty = the git-ignored
# /uploads at the repo root; in Docker the api uses the `uploads` volume automatically.
STORAGE_DRIVER=fs
UPLOADS_DIR=
UPLOAD_MAX_MB=25                         # at most 25 (the contract's limit, FR-DOC-1)
DOCUMENT_MAX_ATTEMPTS=3                  # processing attempts per run, retries included (NFR-13)
WORKERS_ENABLED=true                     # run the document jobs (pg-boss) in the api process
CORS_ORIGIN=http://localhost:3000        # comma-separated web origins allowed to call the API
# Email (#61). Dev: Mailpit catches everything (docker compose up -d mailpit → http://localhost:8025).
# In Docker the api uses mailpit:1025 automatically. Unset SMTP_HOST disables email (sends fail).
# Production: point these at any SMTP provider (port 587 + STARTTLS, or 465 with SMTP_SECURE=true).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="CaseGuard <no-reply@caseguard.local>"
# Real email through Gmail (#116; guide in docs/engineering/local-setup.md). Replace the six lines above with:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=you@gmail.com                  # the full Gmail address
#   SMTP_PASSWORD=abcdefghijklmnop           # 16-character app password, not your Google password
#   MAIL_FROM="CaseGuard <you@gmail.com>"    # Gmail rewrites any other From address
# Then check it: pnpm mail:check --to you@gmail.com
RESET_URL_BASE=http://localhost:3000/reset-password   # web page that reset emails link to (?token=…)

# ── apps/web ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ── Internal service auth (ADR-0002, SEC-14) ─────────────────────────────────
AI_SERVICE_TOKEN=change-me-shared-internal-token

# ── services/ai ──────────────────────────────────────────────────────────────
AI_DATABASE_URL=postgresql+psycopg://caseguard_ai:change-me-ai@localhost:5432/caseguard
# Model gateway (ADR-0005): any OpenAI-compatible endpoint. Assign per role.
# Test a role with: pnpm llm:check  (add --list-models or --role judge). Model catalogs change:
# run --list-models to see what is live before picking a MODEL.
# Provider presets (BASE_URL → example MODEL; get a key from the provider's console):
#   NVIDIA NIM   https://integrate.api.nvidia.com/v1                        nvidia/nemotron-3.5-super-vl-120b-a12b   key: nvapi-…  (build.nvidia.com)
#   Gemini       https://generativelanguage.googleapis.com/v1beta/openai/   gemini-2.5-flash              (aistudio.google.com)
#   Groq         https://api.groq.com/openai/v1                             llama-3.3-70b-versatile
#   OpenRouter   https://openrouter.ai/api/v1                               <vendor>/<model>, e.g. a ":free" model
#   OpenAI       https://api.openai.com/v1                                  gpt-4o-mini
#   Anthropic    https://api.anthropic.com/v1/                              a Claude model id (OpenAI-compatible endpoint)
#   Ollama       http://localhost:11434/v1  (in Docker: http://ollama:11434/v1)   llama3.2     no key needed
LLM_GENERATION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_GENERATION_MODEL=
LLM_GENERATION_API_KEY=
LLM_JUDGE_BASE_URL=
LLM_JUDGE_MODEL=
LLM_JUDGE_API_KEY=
# Optional: the ProviderId of each role (nvidia-nim, gemini, groq, openrouter, openai, anthropic,
# ollama). Left empty, it is inferred from the BASE_URL. A question only reaches a provider the
# Admin has enabled (admin console → providers), and with none, the answer is 503.
LLM_GENERATION_PROVIDER=
LLM_JUDGE_PROVIDER=
# Local fallback for both roles. Set OLLAMA_MODEL (e.g. qwen2.5:7b) to enable it.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=
# In-process models (ADR-0008), pinned to a Hugging Face revision: every machine must build and
# query the corpus with the same one, and `pnpm data:embed` refuses a different one (#18).
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
# Empty = CUDA when torch has a GPU, else CPU.
EMBEDDING_DEVICE=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
# FR-TRUST-6: corpus sources last retrieved more than this many days ago are flagged "stale"
# (the TBD-13 review window).
TRUST_STALE_DAYS=180
# Citation support check (FR-TRUST-3): a multilingual NLI cross-encoder, about 0.6 GB. NLI scores
# P(entailment) and P(contradiction); at or above the thresholds the verdict is pass / fail, else
# uncertain. The thresholds are TBD-13 defaults until calibrated (`pnpm ai:support-eval`).
SUPPORT_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
SUPPORT_REVISION=b5113eb38ab63efdd7f280f8c144ea8b13f978ce
SUPPORT_PASS_THRESHOLD=0.7
SUPPORT_FAIL_THRESHOLD=0.7
# When NLI is uncertain, ask the LLM_JUDGE_* role (or Ollama), only if the request allows it.
SUPPORT_LLM_FALLBACK=true
# Corpus dumps on the private Hugging Face dataset (#154): `pnpm data:dump` / `data:pull --dump`.
# A fine-grained token with write on the repo (read is enough to pull). Empty = the `hf auth
# login` token. Never commit it.
HF_TOKEN=
HF_CORPUS_REPO=caseguard/corpus

# ── services/collector ───────────────────────────────────────────────────────
PKLEGAL_USER_AGENT="CaseGuardAI-Research-Crawler/0.1 (FYP, FAST-NUCES Lahore; contact: <team-email>)"
PKLEGAL_DATABASE_URL=postgresql+psycopg://caseguard_ai:change-me-ai@localhost:5432/caseguard
