# Copy to .env and fill in. Never commit .env.
# Every new variable must be added here with a safe placeholder (CONTRIBUTING.md rule 6).

# ── Database (docker-compose.yml, infra/db, scripts/db-bootstrap.mjs) ────────
# Docker: POSTGRES_USER/PASSWORD create the superuser of the container.
# Native: set them to an existing superuser (usually postgres + your install password);
#         `pnpm db:bootstrap` creates POSTGRES_DB, the roles and the schemas.
# Port: if a native Postgres already listens on 5432 and you also run Docker, set
#       POSTGRES_PORT=5433 and change :5432 to :5433 in the three URLs below.
POSTGRES_USER=caseguard
POSTGRES_PASSWORD=change-me-superuser
POSTGRES_DB=caseguard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# PG_BIN=C:\Program Files\PostgreSQL\17\bin   # only if psql is not on PATH (auto-detected on Windows)
APP_DB_PASSWORD=change-me-app          # role caseguard_app (apps/api, schema app)
AI_DB_PASSWORD=change-me-ai            # role caseguard_ai  (services/ai + collector, schemas corpus, ai)

# ── apps/api ─────────────────────────────────────────────────────────────────
API_PORT=4000
API_DATABASE_URL=postgresql://caseguard_app:change-me-app@localhost:5432/caseguard
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
KEY_ENCRYPTION_KEY=change-me-32-byte-base64-key   # AES-256-GCM key for user API keys (SEC-4)
AI_SERVICE_URL=http://localhost:8000
UPLOAD_MAX_MB=25

# ── Internal service auth (ADR-0002, SEC-14) ─────────────────────────────────
AI_SERVICE_TOKEN=change-me-shared-internal-token

# ── services/ai ──────────────────────────────────────────────────────────────
AI_DATABASE_URL=postgresql+psycopg://caseguard_ai:change-me-ai@localhost:5432/caseguard
# Model gateway (ADR-0005): any OpenAI-compatible endpoint. Assign per role.
LLM_GENERATION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_GENERATION_MODEL=
LLM_GENERATION_API_KEY=
LLM_JUDGE_BASE_URL=
LLM_JUDGE_MODEL=
LLM_JUDGE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
TRUST_REVIEW_WINDOW_DAYS=180

# ── services/collector ───────────────────────────────────────────────────────
PKLEGAL_USER_AGENT="CaseGuardAI-Research-Crawler/0.1 (FYP, FAST-NUCES Lahore; contact: <team-email>)"
PKLEGAL_DATABASE_URL=postgresql+psycopg://caseguard_ai:change-me-ai@localhost:5432/caseguard
