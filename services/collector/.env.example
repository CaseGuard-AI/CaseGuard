# Copy to .env and edit. Never commit .env.

# Identify yourself honestly. A real contact address is what makes a site
# administrator email you instead of silently blocking your university's IP.
PKLEGAL_USER_AGENT="PKLegalFYP-Research-Crawler/0.1 (FYP, <your-university>; contact: you@university.edu.pk)"

PKLEGAL_OUTPUT_DIR=./data
PKLEGAL_REQUEST_DELAY=2.0
PKLEGAL_TIMEOUT=45
PKLEGAL_RETRY_COUNT=4
PKLEGAL_MAX_CONCURRENCY=2
PKLEGAL_RESPECT_ROBOTS=true
PKLEGAL_DOWNLOAD_PDFS=true
PKLEGAL_OCR_ENABLED=false
PKLEGAL_OCR_LANG=eng
PKLEGAL_LOG_LEVEL=INFO

# Only set once the JSONL corpus is stable.
# PKLEGAL_DATABASE_URL=postgresql+psycopg://pklegal:password@localhost:5432/pklegal

# Permission gates. Set to 1 ONLY when you hold written permission from the
# site owner, and keep the letter on file for your FYP report.
# PKLEGAL_PERMISSION_LAHORE_HIGH_COURT=0
